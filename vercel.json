{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/search.js": {
      "maxDuration": 60
    },
    "api/scrape.js": {
      "maxDuration": 90
    },
    "api/cron/*.py": {
      "maxDuration": 300,
      "includeFiles": "{etl/**,api/cron/_common.py,public/data/company-profiles/**}"
    },
    "api/filing.js": {
      "maxDuration": 60
    },
    "api/screen.js": {
      "maxDuration": 60
    },
    "api/cron/analyst.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/prices?part=0&parts=8",
      "schedule": "40 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=1&parts=8",
      "schedule": "42 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=2&parts=8",
      "schedule": "44 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=3&parts=8",
      "schedule": "46 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=4&parts=8",
      "schedule": "48 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=5&parts=8",
      "schedule": "50 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=6&parts=8",
      "schedule": "52 21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?part=7&parts=8",
      "schedule": "54 21 * * 1-5"
    },
    {
      "path": "/api/cron/macro",
      "schedule": "10 12 * * *"
    },
    {
      "path": "/api/cron/companies",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/companies?run=2",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/companies?run=3",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/cron/companies?run=4",
      "schedule": "20 20 * * *"
    },
    {
      "path": "/api/cron/companies?run=5",
      "schedule": "20 23 * * *"
    },
    {
      "path": "/api/cron/companies?run=6",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/news?run=2",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/insiders",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/insiders?run=2",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/altdata?step=market",
      "schedule": "17 1 * * 2-6"
    },
    {
      "path": "/api/cron/altdata?step=refresh",
      "schedule": "47 */3 * * *"
    },
    {
      "path": "/api/cron/segments",
      "schedule": "50 12 * * *"
    },
    {
      "path": "/api/cron/segments?run=2",
      "schedule": "50 0 * * *"
    },
    {
      "path": "/api/cron/ir",
      "schedule": "40 14 * * *"
    },
    {
      "path": "/api/cron/ir?run=2",
      "schedule": "40 22 * * *"
    },
    {
      "path": "/api/cron/ir?run=3",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron/compare",
      "schedule": "25 22 * * 1-5"
    },
    {
      "path": "/api/cron/sectors?step=prices",
      "schedule": "5 21 * * 1-5"
    },
    {
      "path": "/api/cron/sectors",
      "schedule": "35 22 * * 1-5"
    },
    {
      "path": "/api/cron/sectors?step=notes",
      "schedule": "15 12 * * 1"
    },
    {
      "path": "/api/cron/kpistd",
      "schedule": "5 22 * * *"
    },
    {
      "path": "/api/cron/kpistd?run=2",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/cron/kpistd?run=3",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/kpistd?run=4",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/cron/screener",
      "schedule": "55 22 * * *"
    },
    {
      "path": "/api/cron/technicals?part=0&parts=4",
      "schedule": "5 22 * * 1-5"
    },
    {
      "path": "/api/cron/technicals?part=1&parts=4",
      "schedule": "12 22 * * 1-5"
    },
    {
      "path": "/api/cron/technicals?part=2&parts=4",
      "schedule": "19 22 * * 1-5"
    },
    {
      "path": "/api/cron/technicals?part=3&parts=4",
      "schedule": "26 22 * * 1-5"
    },
    {
      "path": "/api/cron/technicals?merge=1&parts=4",
      "schedule": "10 23 * * 1-5"
    },
    {
      "path": "/api/cron/mdata?source=calendar",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/mdata?source=oecd",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/mdata?source=fdic",
      "schedule": "40 9 * * 1"
    },
    {
      "path": "/api/cron/mdata?source=bls",
      "schedule": "50 13 * * *"
    },
    {
      "path": "/api/cron/mdata?source=nyfed",
      "schedule": "25 18 * * *"
    },
    {
      "path": "/api/cron/mdata?source=cftc",
      "schedule": "55 20 * * *"
    },
    {
      "path": "/api/cron/mdata?source=frb_monthly",
      "schedule": "15 21 * * *"
    },
    {
      "path": "/api/cron/mdata?source=frb_weekly",
      "schedule": "45 22 * * *"
    },
    {
      "path": "/api/cron/mdata?source=frb_daily",
      "schedule": "15 23 * * 1-5"
    },
    {
      "path": "/api/cron/mdata?source=treasury",
      "schedule": "35 23 * * 1-5"
    },
    {
      "path": "/api/cron/statements",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/analyst",
      "schedule": "5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/app.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
