{
  "about": "Prompts for the screen agent (/api/screen) with the filters a correct screen must contain. A case passes when every expected filter is present (field, any of the listed fields when several are given, and direction: gt covers > >= top, lt covers < <= bottom), expected universe constraints are present, the expected sort field matches when given, and the spec adds no more unrequested filters than max_extra (default 1). Values are checked only where value_min/value_max are given.",
  "cases": [
    {"prompt": "profitable small caps with accelerating revenue that correlate with oil",
     "filters": [{"field": "nm", "dir": "gt"}, {"field": "mcap", "dir": "lt"}, {"field": "rev_accel", "dir": "gt"}, {"field": "c_oil", "dir": "gt"}]},
    {"prompt": "like NVDA in 2016 but cheaper",
     "filters": [{"field": ["rev_g_ttm", "rev_g_q", "rev_cagr3", "rev_cagr5"], "dir": "gt"}, {"field": ["pe", "ps", "ev_sales", "ev_ebit", "pe_p5", "ev_sales_p5"], "dir": "lt"}], "max_extra": 3},
    {"prompt": "banks most hurt by falling rates",
     "filters": [{"field": "c_tnx", "dir": "gt"}], "industries_match": "bank", "sort": "c_tnx"},
    {"prompt": "quality compounders",
     "filters": [{"field": ["roic", "roe"], "dir": "gt"}], "max_extra": 3},
    {"prompt": "high free cash flow yield with low debt",
     "filters": [{"field": "fcf_yield", "dir": "gt"}, {"field": ["nd_ebitda", "de"], "dir": "lt"}]},
    {"prompt": "momentum leaders above the 200-day moving average",
     "filters": [{"field": ["mom_rank_3m", "ret_3m", "ret_6m"], "dir": "gt"}, {"field": "above_sma200", "dir": "true"}]},
    {"prompt": "insider cluster buying",
     "filters": [{"field": "ins_buyers_90d", "dir": "gt", "value_min": 2}]},
    {"prompt": "rate-sensitive names that fall when yields rise",
     "filters": [{"field": ["c_tnx", "cm_10y"], "dir": "lt"}]},
    {"prompt": "dollar-hurt multinationals",
     "filters": [{"field": "c_dxy", "dir": "lt"}], "max_extra": 2},
    {"prompt": "dividend growers",
     "filters": [{"field": "div_yield", "dir": "gt"}, {"field": ["eps_cagr5", "eps_cagr3", "eps_g_ttm"], "dir": "gt"}], "max_extra": 2},
    {"prompt": "turnaround candidates",
     "filters": [{"field": ["rev_accel", "oi_g_q", "rev_g_q"], "dir": "gt"}, {"field": ["ret_1y", "ret_6m"], "dir": "lt"}], "max_extra": 2},
    {"prompt": "stocks within 5% of their 52-week high",
     "filters": [{"field": "dist_hi52", "dir": "gt", "value_min": -0.06, "value_max": -0.04}]},
    {"prompt": "oversold tech stocks",
     "filters": [{"field": "rsi14", "dir": "lt"}], "sectors": ["Information Technology"]},
    {"prompt": "companies with net cash and operating margins above 30%",
     "filters": [{"field": "net_debt", "dir": "lt"}, {"field": "om", "dir": "gt", "value_min": 0.29, "value_max": 0.31}]},
    {"prompt": "cheapest 20% of each sector on EV/EBIT",
     "filters": [{"field": "ev_ebit", "dir": "lt", "scope": "sector"}]},
    {"prompt": "high beta consumer discretionary names",
     "filters": [{"field": "beta", "dir": "gt"}], "sectors": ["Consumer Discretionary"]},
    {"prompt": "low volatility utilities yielding more than 3%",
     "filters": [{"field": ["vol_1y", "vol_60d", "beta"], "dir": "lt"}, {"field": "div_yield", "dir": "gt", "value_min": 0.029, "value_max": 0.031}], "sectors": ["Utilities"]},
    {"prompt": "S&P 100 companies buying back more than 3% of their stock a year",
     "filters": [{"field": ["bb_yield", "shr_chg1"], "dir": "any"}], "index": "sp100"},
    {"prompt": "semiconductor stocks with revenue growth over 30%",
     "filters": [{"field": ["rev_g_ttm", "rev_g_q"], "dir": "gt", "value_min": 0.29, "value_max": 0.31}], "industries_match": "semiconductor"},
    {"prompt": "health care companies trading below their usual P/E over the last five years",
     "filters": [{"field": "pe_p5", "dir": "lt"}], "sectors": ["Health Care"]},
    {"prompt": "stocks that barely move with the S&P 500",
     "filters": [{"field": "c_spy", "dir": "lt"}]},
    {"prompt": "gold-sensitive names",
     "filters": [{"field": "c_gold", "dir": "gt"}]},
    {"prompt": "companies expected to report earnings in the next week",
     "filters": [{"field": "next_earn_days", "dir": "any"}]},
    {"prompt": "Piotroski score of 8 or more and Altman Z above 3",
     "filters": [{"field": "pio_f", "dir": "gt", "value_min": 7.5, "value_max": 8}, {"field": "altman_z", "dir": "gt", "value_min": 3, "value_max": 3}]},
    {"prompt": "unprofitable companies growing revenue fast",
     "filters": [{"field": ["nm", "earn_yield"], "dir": "lt"}, {"field": ["rev_g_ttm", "rev_g_q"], "dir": "gt"}]},
    {"prompt": "stocks that move with bitcoin",
     "filters": [{"field": "c_btc", "dir": "gt"}]},
    {"prompt": "large caps with ROE above 20% and debt to equity below 1",
     "filters": [{"field": "mcap", "dir": "gt"}, {"field": "roe", "dir": "gt", "value_min": 0.2, "value_max": 0.2}, {"field": "de", "dir": "lt", "value_min": 1, "value_max": 1}]},
    {"prompt": "companies whose share count grew the most over three years",
     "filters": [], "sort": "shr_chg3", "max_extra": 1},
    {"prompt": "now only above the 200-day",
     "current": {"filters": [{"field": "nm", "op": ">", "value": 0}, {"field": "mcap", "op": "<", "value": 20000000000}], "sort": {"field": "mcap", "dir": "desc"}},
     "filters": [{"field": "nm", "dir": "gt"}, {"field": "mcap", "dir": "lt"}, {"field": "above_sma200", "dir": "true"}], "max_extra": 0},
    {"prompt": "drop banks and sort by FCF yield",
     "current": {"filters": [{"field": "mom_rank_3m", "op": ">", "value": 0.8}, {"field": "above_sma200", "op": "true"}], "sort": {"field": "ret_6m", "dir": "desc"}},
     "filters": [{"field": "mom_rank_3m", "dir": "gt"}, {"field": "above_sma200", "dir": "true"}], "exclude_match": "bank|Financials", "sort": "fcf_yield", "max_extra": 0}
  ]
}
