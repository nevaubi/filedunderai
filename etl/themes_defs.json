    {
      "id": "cyber_incidents",
      "name": "Cybersecurity incidents",
      "description": "Cyber incidents a company says actually happened to it (detected, experienced, disclosed), not generic cyber-risk language.",
      "include": [
        "\\b(we|the\\s+company|company)\\s+(recently\\s+)?(experienced|identified|detected|discovered|became\\s+aware\\s+of|were\\s+(the\\s+)?(subject|target|victim)\\s+of|was\\s+(the\\s+)?(subject|target|victim)\\s+of|suffered|incurred)\\b.{0,100}\\b(cyber|ransomware|unauthori[sz]ed\\s+(access|third\\s+part)|breach|intrusion|threat\\s+actor|malicious|security\\s+incident)",
        "\\b(on|in)\\s+(january|february|march|april|may|june|july|august|september|october|november|december)\\b.{0,60}\\b(cyber(security)?\\s+incident|ransomware\\s+attack|unauthori[sz]ed\\s+access)",
        "\\bitem\\s+1\\.05\\b",
        "\\b(the|this)\\s+(cyber(security)?|ransomware|security)\\s+(incident|attack)\\s+(resulted|caused|disrupted|impacted|affected)"
      ],
      "exclude": [
