{
  "version": 1,
  "notes": "Phrase sets are Python regular expressions, matched case-insensitively unless a pattern starts with (?-i). A sentence counts for a theme when any include pattern matches and no exclude pattern matches. Sentences that are negated or hedged ('did not have a material impact') still count as mentions but are flagged; sentences that appear word-for-word (digits masked) in many companies' filings are treated as shared boilerplate and do not count. Basket rules rank companies by disclosed exposure: revenue share from reported geography/customer data, segment names, and named counterparties in the supply graph.",
  "themes": [
    {
      "id": "tariffs",
      "name": "Tariffs and trade policy",
      "description": "Import tariffs, duties, Section 232/301 actions, reciprocal tariffs, trade restrictions and their cost or demand effects.",
      "include": [
        "\\btariffs?\\b",
        "\\bsection\\s+(232|301)\\b",
        "\\b(anti-?dumping|countervailing)\\s+dut",
        "\\bimport\\s+dut(y|ies)\\b",
        "\\btrade\\s+(war|tensions?|restrictions?|barriers?|polic(y|ies)|disputes?)\\b",
        "\\bretaliatory\\s+(measures|dut|tariff)"
      ],
      "exclude": [
        "\\b(rate|transmission|tariff\\s+filings?|open\\s+access|ferc|public\\s+utilit|utility\\s+commission|feed-?in)\\b.{0,40}\\btariff",
        "\\btariff.{0,40}\\b(ferc|rate\\s+case|transmission|utility\\s+commission|regulated\\s+rates)\\b",
        "\\btariff\\s+(rates?\\s+approved|schedules?)\\b"
      ],
      "basket": {
        "counterparty_regions": ["China", "Mexico", "Vietnam", "Taiwan", "Canada"],
        "geo_terms": "\\b(china|greater\\s+china|prc|mainland|hong\\s+kong|mexico|canada)\\b",
        "segment_terms": null,
        "counterparties": []
      }
    },
    {
      "id": "ai",
      "name": "Artificial intelligence",
      "description": "AI products, AI infrastructure and demand, generative AI, machine learning and large language models.",
      "include": [
        "artificial\\s+intelligence",
        "(?-i)\\bA\\.?I\\.?\\b(?!\\s*Group)",
        "\\bgen(erative)?[- ]?ai\\b",
        "large\\s+language\\s+models?",
        "(?-i)\\bLLMs?\\b",
        "machine\\s+learning",
        "\\bagentic\\b",
        "\\bAI[- ](enabled|powered|driven|native|infrastructure|workloads?|accelerators?|servers?|data\\s+cent)"
      ],
      "exclude": [],
      "basket": {
        "counterparty_regions": [],
        "geo_terms": null,
        "segment_terms": "\\b(data\\s+cent(er|re)|ai\\b|artificial\\s+intelligence|cloud|accelerat|compute|networking|semiconductor\\s+solutions)",
        "counterparties": ["NVIDIA", "NVDA", "OpenAI", "Anthropic", "AMD", "Microsoft Azure", "CoreWeave", "CRWV", "AVGO", "Broadcom", "TSM", "TSMC", "xAI"]
      }
    },
    {
      "id": "glp1",
      "name": "GLP-1 and obesity drugs",
      "description": "GLP-1 receptor agonists and anti-obesity medicines: supply, demand effects on food, medtech, insurers and retailers.",
      "include": [
        "\\bglp-?1\\b",
        "glucagon-like\\s+peptide",
        "\\b(semaglutide|tirzepatide|retatrutide|orforglipron|ozempic|wegovy|mounjaro|zepbound|saxenda)\\b",
        "\\b(anti-?obesity|weight[- ]loss|weight[- ]management)\\s+(drugs?|medications?|medicines?|therap(y|ies)|treatments?)\\b",
        "\\bobesity\\s+(drugs?|medications?|medicines?|therap(y|ies)|treatments?)\\b"
      ],
      "exclude": [],
      "basket": {
        "counterparty_regions": [],
        "geo_terms": null,
        "segment_terms": "\\b(obesity|diabet|cardiometabolic|metabolic)\\b",
        "counterparties": ["Novo Nordisk", "NVO", "Eli Lilly", "LLY"]
      }
    },
    {
      "id": "reshoring",
      "name": "Reshoring and nearshoring",
      "description": "Moving production or sourcing closer to the U.S. or out of China: reshoring, nearshoring, China+1, new domestic capacity tied to CHIPS/IRA incentives.",
      "include": [
        "\\b(re|on|near|friend)-?shor(e|ed|es|ing)\\b",
        "\\bchina\\s*(\\+|plus)\\s*(1|one)\\b",
        "\\b(relocat|shift|mov|transition|diversif)\\w*\\s+(of\\s+)?(our\\s+|certain\\s+|some\\s+)?(production|manufacturing|sourcing|supply\\s+chain|assembly)\\b.{0,60}\\b(mexico|united\\s+states|u\\.s\\.|north\\s+america|vietnam|india|thailand|malaysia|out\\s+of\\s+china|outside\\s+(of\\s+)?china)",
        "\\bchips\\s+(and\\s+science\\s+)?act\\b",
        "\\bdomestic\\s+(manufacturing|production)\\s+(capacity|footprint|investment|facilit)"
      ],
      "exclude": [
        "\\boffshore\\s+(wind|drilling|rig|platform)",
