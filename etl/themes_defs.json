  ],
  "negation": "\\b(not|no|never|neither|nor|without)\\b.{0,50}\\b(material|significant|meaningful|substantial|expect|anticipate|experienced|impact|affect)|\\bimmaterial\\b|\\b(did|does|do|has|have|had)\\s+not\\b|\\bno\\s+(significant|material)\\b",
