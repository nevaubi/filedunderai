        "\\bnot\\s+(experienced|identified|detected|aware)\\b.{0,60}\\b(material|cyber|incident)",
        "\\bto\\s+date\\b.{0,60}\\bnot\\b"
      ],
      "basket": {
        "counterparty_regions": [],
        "geo_terms": null,
        "segment_terms": null,
        "counterparties": []
      }
    },
    {
      "id": "labor",
